        android:fillColor="#FFFFFF"
        android:pathData="M12,2 L4,5.5 L4,11.5 C4,16.4 7.4,20.9 12,22 C16.6,20.9 20,16.4 20,11.5 L20,5.5 Z" />
</vector>
