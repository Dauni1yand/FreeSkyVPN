<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The tunnel runs as a foreground service; Android 14+ additionally
         requires the typed permission below. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Android 13+ will not show the ongoing VPN notification without it.
         A refusal is survivable: the tunnel still works, the user just has
         no quick way back to the app. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Package visibility for the split tunnel.

        QUERY_ALL_PACKAGES is deliberately NOT requested. Google Play grants
        it only for a short list of app categories that does not clearly
        include VPNs, and a rejected permission is a rejected release. What
        the split tunnel actually needs is narrower: to see the specific
        Russian apps the routing policy names, plus whatever the user can
        launch. Both are available without it.

        The <intent> block below makes every launchable app visible, which
        is what fills the settings list. Apps that ship no launcher icon
        stay invisible, which is correct — they are not what anyone is
        looking for on that screen.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".FreeSkyApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.FreeSkyVPN">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.FreeSkyVPN">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            The VPN service.

            BIND_VPN_SERVICE is what stops any other app from starting this
            one: only the system may bind it, and only after the user has
            granted consent through the dialog VpnService.prepare() shows.
        -->
        <service
            android:name=".vpn.FreeSkyVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn" />
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
    </application>
</manifest>
