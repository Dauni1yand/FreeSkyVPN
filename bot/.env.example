# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Головной сервер
HEAD_API_URL=http://localhost:8000
# должен совпадать с HEAD_SECRET_KEY на голове
HEAD_SERVICE_TOKEN=

# Telegram Payments: @BotFather -> Payments -> выбрать провайдера.
# Пусто = кнопки покупки скрыты, триал и бесплатный доступ работают.
PAYMENT_PROVIDER_TOKEN=

# как часто разбирается очередь доставки новых конфигов
OUTBOX_POLL_SECONDS=15
