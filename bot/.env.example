# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Головной сервер
HEAD_API_URL=http://localhost:8000
# должен совпадать с ADMIN_API_TOKEN на голове.
# Это служебный токен (X-Admin-Token), не тот, что зашит в приложение.
HEAD_ADMIN_TOKEN=

# Как выйти к Telegram, если он заблокирован там, где стоит сервер.
# Пусто = напрямую. socks5:// и http:// оба подходят.
TELEGRAM_PROXY_URL=

# Кому бот вообще отвечает. Пусто = никому: бот служебный, а не
# пользовательский. Свой id узнать у @userinfobot.
TELEGRAM_ADMIN_CHAT_ID=
# Дополнительные операторы через запятую, если их больше одного.
TELEGRAM_ALLOWED_CHAT_IDS=

# как часто разбирается очередь доставки новых конфигов
OUTBOX_POLL_SECONDS=15
