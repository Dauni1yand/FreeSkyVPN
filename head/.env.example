# PostgreSQL — единственное хранилище состояния головного сервера
DATABASE_URL=postgresql+psycopg://freeskyvpn:freeskyvpn@localhost:5432/freeskyvpn

# Сессии админки и сервисный токен для бота. python -m app.cli generate-key
HEAD_SECRET_KEY=change-me
# Шифрование SSH-учёток нод. Потеря = учётки не восстановить, смена = отвяжутся.
SECRETS_KEY=change-me
ADMIN_SESSION_HOURS=12
# false только за прокси без TLS (dev): cookie по чистому HTTP перехватывается
ADMIN_COOKIE_SECURE=true

# Алерты об изоляции ноды (см. app/node_manager/telegram_signal.py)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Порог переключения канала управления нодой: direct -> Reality-туннель -> isolated
NODE_CHANNEL_PRIMARY_TIMEOUT_S=3
NODE_CHANNEL_PRIMARY_FAILS_BEFORE_FALLBACK=3
NODE_CHANNEL_FALLBACK_FAILS_BEFORE_ISOLATED=3

# Бинарь xray-core на самой голове — для Reality-туннеля (fallback-путь)
# и для генерации Reality-ключей новым инбаундам (`xray x25519`)
XRAY_CLIENT_BINARY_PATH=/usr/local/bin/xray

# mTLS-личность головы, которую принимают все ноды
# (см. provisioning/generate_head_client_cert.sh)
HEAD_CLIENT_CERT_PATH=/etc/freeskyvpn/head_client_cert.pem
HEAD_CLIENT_KEY_PATH=/etc/freeskyvpn/head_client_key.pem
# сюда раскладываются самоподписанные сертификаты нод из БД (для httpx verify=)
NODE_CERT_CACHE_DIR=/var/lib/freeskyvpn/node_certs

# Config Selector (фаза 2)
INBOUND_FAIL_THRESHOLD=5
INBOUND_FAIL_WINDOW_MINUTES=10
FAIL_REPORT_COOLDOWN_SECONDS=30
NODE_DEAD_INBOUND_THRESHOLD=2

# Автоподбор SNI (app/services/sni_discovery.py)
SNI_USE_TRANCO=true
SNI_POOL_SIZE=200
SNI_SKIP_TOP_RANKS=500
SNI_PROBE_BATCH=100
SNI_PROBE_TIMEOUT_S=6
SNI_PROBE_MAX_AGE_HOURS=168
SNI_REFRESH_INTERVAL_HOURS=24
SNI_MAINTENANCE_ENABLED=true
# запасные домены, если источник популярности недоступен: SNI_SEED_DOMAINS='["a.com","b.com"]'
SNI_SEED_DOMAINS=[]
# собственные домены — никогда не предлагать как dest
OWN_DOMAINS=[]

# Тарифы (фаза 4)
TIER_RECONCILE_INTERVAL_MINUTES=30
FREE_NODE_SHAPED_MBIT=10
