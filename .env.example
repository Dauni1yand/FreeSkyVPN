# --- база ---
POSTGRES_USER=freeskyvpn
POSTGRES_PASSWORD=          # придумайте длинный пароль
POSTGRES_DB=freeskyvpn

# --- ключи (сгенерировать: docker compose run --rm head python -m app.cli generate-key) ---
# Подписывает сессии админки и служит токеном между головой и ботом
HEAD_SECRET_KEY=
# Шифрует SSH-учётки нод в базе. Потеряете — учётки не восстановить.
SECRETS_KEY=

# --- телеграм ---
TELEGRAM_BOT_TOKEN=         # от @BotFather
TELEGRAM_ADMIN_CHAT_ID=     # куда слать алерты об изоляции нод
PAYMENT_PROVIDER_TOKEN=     # @BotFather -> Payments; пусто = покупка скрыта

# --- прочее ---
# true, если перед головой стоит HTTPS-прокси (так и надо на проде)
ADMIN_COOKIE_SECURE=true
