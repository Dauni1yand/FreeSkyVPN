# Скопируйте в .env и заполните пустые значения.
# Комментарии держим на отдельных строках: значение читается до конца строки,
# и приписка после него слишком легко становится частью пароля.

# --- база ---
POSTGRES_USER=freeskyvpn
# Придумайте длинный пароль. Наружу база не торчит, но он попадёт в строку
# подключения, так что пусть будет не словарным.
POSTGRES_PASSWORD=
POSTGRES_DB=freeskyvpn

# --- ключи ---
# Генерируются на хосте, не через compose: стек намеренно не стартует с
# пустыми ключами, так что получить их изнутри него нельзя.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Если Python на сервере нет: openssl rand -base64 36
#
# Подписывает сессии админки и служит токеном между головой и ботом.
# Смените — все разлогинятся, боту понадобится новый токен.
HEAD_SECRET_KEY=
# Шифрует SSH-учётки нод в базе. Потеряете — доступ к нодам из админки не
# восстановить, придётся заходить на них вручную. Храните отдельно от сервера.
SECRETS_KEY=

# --- телеграм ---
# От @BotFather. Без него бот не запустится.
TELEGRAM_BOT_TOKEN=
# Куда слать алерты, когда нода перестала отвечать по обоим каналам.
# Свой id можно узнать у @userinfobot. Пусто = алертов не будет.
TELEGRAM_ADMIN_CHAT_ID=
# @BotFather -> Payments. Пусто = кнопки покупки скрыты, триал и бесплатный
# доступ работают как обычно — удобно, пока платежи не подключены.
PAYMENT_PROVIDER_TOKEN=

# --- прочее ---
# true, если перед головой стоит HTTPS-прокси (на проде — так и надо).
# false только для локальной отладки по http.
ADMIN_COOKIE_SECURE=true
