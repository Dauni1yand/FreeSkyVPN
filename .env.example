# Скопируйте в .env и заполните пустые значения.
# Комментарии держим на отдельных строках: значение читается до конца строки,
# и приписка после него слишком легко становится частью пароля.

# --- база ---
POSTGRES_USER=freeskyvpn
# Придумайте длинный пароль. Наружу база не торчит, но он попадёт в строку
# подключения, так что пусть будет не словарным.
POSTGRES_PASSWORD=
POSTGRES_DB=freeskyvpn

# --- ключи ---
# Генерируются на хосте, не через compose: стек намеренно не стартует с
# пустыми ключами, так что получить их изнутри него нельзя.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Если Python на сервере нет: openssl rand -base64 36
#
# Подписывает сессии админки и служит токеном между головой и ботом.
# Смените — все разлогинятся, боту понадобится новый токен.
HEAD_SECRET_KEY=
# Шифрует SSH-учётки нод в базе. Потеряете — доступ к нодам из админки не
# восстановить, придётся заходить на них вручную. Храните отдельно от сервера.
SECRETS_KEY=
# Второй ключ, и он важнее первого. HEAD_SECRET_KEY компилируется в APK и
# поэтому публичен по определению — кто распакует приложение, тот его знает.
# Этот не покидает сервер и закрывает всё, что действует от чужого имени:
# выдачу доступа, регистрацию нод, подтверждение обновлений, чтение очереди
# рассылок. Его знают только голова, бот и скрипты провижининга.
# Обязательно отличается от HEAD_SECRET_KEY.
ADMIN_API_TOKEN=

# --- телеграм ---
# От @BotFather. Без него бот не запустится.
TELEGRAM_BOT_TOKEN=
# Куда слать алерты (нода перестала отвечать по обоим каналам) и запросы на
# подтверждение обновлений Xray. Этот же чат — единственный, кому бот
# разрешает нажимать кнопку «Обновить»: сообщение с кнопками можно переслать
# кому угодно, поэтому решает не кнопка, а id.
# Свой id можно узнать у @userinfobot. Пусто = алертов и запросов не будет,
# обновления останутся доступны только через админку.
TELEGRAM_ADMIN_CHAT_ID=
# Кому бот может выдавать доступ без рекламы, через запятую.
# Бот не умеет показывать rewarded video — у Telegram нет такого SDK, — поэтому
# он не участвует в том, что оплачивает серверы. Без списка это была бы дыра
# в обход рекламы. Админ из строки выше разрешён всегда.
TELEGRAM_ALLOWED_CHAT_IDS=

# --- выход к Telegram ---
# Telegram заблокирован в РФ, а голова стоит именно там. Без обходного пути
# бот падает на первом же запросе long polling, а голова не может доставить
# алерт о недоступных нодах.
#
# Пусто = идти напрямую. За пределами РФ так и надо.
#
# Заполняется вместе с блоком ниже:
#   TELEGRAM_PROXY_URL=socks5://egress:1080
# Принимается и любой свой прокси: socks5://... или http://...
TELEGRAM_PROXY_URL=

# Контейнер egress выводит трафик через вашу же ноду тем же протоколом
# VLESS+Reality, каким пользуются клиенты — со стороны это ещё один
# пользователь VPN, а не канал управления.
#
# Включается так:
#   1. COMPOSE_PROFILES=egress          (строка ниже)
#   2. docker compose exec head python -m app.cli egress-url
#   3. полученную ссылку — в EGRESS_VLESS_URL
#   4. TELEGRAM_PROXY_URL=socks5://egress:1080
#   5. docker compose up -d
#
# Оговорка, которую стоит знать: алерт «все ноды недоступны», отправленный
# через собственную ноду, замолчит ровно тогда, когда замолчит весь флот.
# Ссылка на независимый сервер стоит ещё одной машины и снимает это.
# COMPOSE_PROFILES=egress
EGRESS_VLESS_URL=

# --- прочее ---
# true, если перед головой стоит HTTPS-прокси (на проде — так и надо).
# false только для локальной отладки по http.
ADMIN_COOKIE_SECURE=true
